# 生产环境配置示例
# 复制此文件为 .env 并修改相应配置

APP_NAME="飞鹰管理系统"

# 网站图标：浏览器标签页图标与各页 Logo（留空则用默认 SVG）
APP_FAVICON=/484cdc20a11481a1ba7f6a0ae10d28c7.png
APP_LOGO=/484cdc20a11481a1ba7f6a0ae10d28c7.png


APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://你的域名.com

# 时区
TIMEZONE=Asia/Shanghai

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# 日志配置
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# 数据库配置（Docker 内部网络使用服务名）
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=feiying_v2
DB_USERNAME=feiying
DB_PASSWORD=你的强密码_修改这里

# Session 配置
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=feiying_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Redis 配置（Docker 内部网络使用服务名）
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# 邮件配置
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite
VITE_APP_NAME="${APP_NAME}"

# Docker 端口配置
# 使用 8080 端口，让宝塔 Nginx 监听 80/443 并反向代理
APP_PORT=8080


# WebSocket 配置（直接通过端口访问，不走 Nginx 代理）
# HTTP 环境使用 ws://，HTTPS 环境需要单独配置 SSL 或使用 ws://
WEBSOCKET_URL=ws://你的域名.com:8081
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8081

# Docker 镜像配置（可选）
# 配置后 deploy.sh 会从远程仓库拉取镜像，而非本地构建
# 不配置则默认本地构建 feiying-app:latest
# APP_IMAGE=registry.cn-hangzhou.aliyuncs.com/yourns/feiying-app:latest
