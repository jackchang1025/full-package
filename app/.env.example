APP_NAME="飞鹰管理系统"
APP_ENV=local
APP_KEY=base64:brUmCR7UWQG4pWVQGtwfOrU3JoySJzrbI5hdXjeAFxs=
APP_DEBUG=true
APP_URL=http://localhost

#设置时区
TIMEZONE=Asia/Shanghai

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=feiying_v2
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=feiying_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@feiying.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# 网站图标：浏览器标签页图标与各页 Logo（留空则用默认 SVG）
APP_FAVICON="/favicon.ico"
APP_LOGO=""

# Sail 用户配置 (避免权限问题)
WWWUSER=1001
WWWGROUP=1002

# Sail 端口配置 (避免冲突)
APP_PORT=8899

# 设备控制 WebSocket 地址 (PHP Swoole 服务器)
# 前端和后端共用此配置（通过 vite.config.ts 暴露给前端）
WEBSOCKET_URL=ws://your-server-ip:8081

WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8081

# GeoIP 数据库（可选，用于 IP 归属地。不设则需从 legacy 复制或手动下载）
# 获取: https://www.maxmind.com/en/geolite2/signup
# MAXMIND_LICENSE_KEY=
