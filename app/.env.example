APP_NAME="安卓设备管理大师"
APP_LOGO=/484cdc20a11481a1ba7f6a0ae10d28c7.png
# 网站图标：浏览器标签页图标与各页 Logo（留空则用默认 SVG）
APP_FAVICON=/484cdc20a11481a1ba7f6a0ae10d28c7.png

# 后台设置：网站 Logo 上传大小上限（单位 KB，默认 10240 = 10MB）
# SITE_LOGO_MAX_SIZE_KB=10240

APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

#设置时区
TIMEZONE=Asia/Shanghai


APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=feiying_v2
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=feiying_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@feiying.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Sail 用户配置 (避免权限问题)
WWWUSER=1001
WWWGROUP=1002

# Sail 端口配置 (避免冲突)
APP_PORT=8080


# 设备控制 WebSocket 地址 (PHP Swoole 服务器)
# 前端和后端共用此配置（通过 vite.config.ts 暴露给前端）
WEBSOCKET_URL=ws://your-server-ip:8081

WEBSOCKET_HOST=your-server-ip
WEBSOCKET_PORT=8081
DEVICE_AUTH_SECRET=
# 局域网开发配置 - Vite 开发服务器 host
# 设置为本机 IP 以支持手机等局域网设备访问
VITE_DEV_HOST=your-server-ip

# 设备数据转发到 Panel 时的日志级别
WEBSOCKET_LOG_LEVEL=info

# 镜像地址
APP_IMAGE=registry.cn-hangzhou.aliyuncs.com/yourns/feiying-app:latest
